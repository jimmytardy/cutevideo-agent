# Auth multi-utilisateurs
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand
# Chiffre les clés API des utilisateurs : `openssl rand -hex 32` (ou une clé Fernet).
# Obligatoire : seule clé de chiffrement (la changer rend les clés enregistrées illisibles).
API_KEYS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Connexion alternative par code Google Authenticator (générer avec scripts/totp_setup.py <email>)
# TOTP_SECRET=
# TOTP_LOGIN_EMAIL=
# Dev Docker (app-dev, PORT=3333) : passer par le proxy Next.js, pas le port 8000 interne.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/auth/google/callback
# Dev local split (uvicorn :8000 + next :3000) : alternative directe
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# IA — Anthropic optionnel (fallback Gemini gratuit si absent)
ANTHROPIC_API_KEY=

# --- Claude Studio (création des vidéos par Claude Code CLI) ---
# Auth du CLI : abonnement Claude (recommandé) → générer un token avec `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# "subscription" (défaut) : ANTHROPIC_API_KEY n'est PAS transmise au CLI.
# "api_key" : le CLI utilise ANTHROPIC_API_KEY (facturation API).
CLAUDE_STUDIO_AUTH=subscription
CLAUDE_STUDIO_MODEL=claude-opus-5-5
CLAUDE_STUDIO_TIMEOUT_S=3600
CLAUDE_STUDIO_MAX_TURNS=400
# Plafond de dépense par vidéo (uniquement en mode api_key)
# CLAUDE_STUDIO_MAX_BUDGET_USD=5
# Images IA (Flux) max par vidéo, en dernier recours après les banques gratuites
STUDIO_MAX_AI_IMAGES=4
# Modèle Whisper pour le calage mot à mot (small suffit, large-v3 ≈ 3 Go de RAM)
STUDIO_WHISPER_MODEL=small
# Bac à sable des scripts d'animation écrits par Claude : auto (bwrap si dispo) | bwrap | container | none.
# Docker : "container" (service studio-sandbox, posé par docker-compose). none = modèles intégrés seulement.
# STUDIO_SANDBOX=auto
# Dossier des runs (hors du repo) ; défaut ~/.cache/cutevideo/runs
# STUDIO_RUNS_DIR=


# Base de données
# Dev local (hors Docker) — ports mappés par docker-compose :
DATABASE_URL=postgresql+asyncpg://cutevideo:cutevideo@localhost:5433/cutevideo
REDIS_URL=redis://localhost:6380

# Sources médias libres
UNSPLASH_ACCESS_KEY=...
PEXELS_API_KEY=...
PIXABAY_API_KEY=...
COVERR_API_KEY=...
FREESOUND_API_KEY=...
EUROPEANA_API_KEY=...

# YouTube (compte Google partagé — chaînes Brand en DB)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/channels/youtube/oauth/callback
API_BASE_URL=http://localhost:8000

# Instagram (token global — page_id par chaîne en DB)
INSTAGRAM_ACCESS_TOKEN=...
INSTAGRAM_PAGE_ID=...

# Composio (TikTok : un compte OAuth par chaîne)
COMPOSIO_API_KEY=...
# Optionnel : auth config TikTok custom depuis le dashboard Composio (sinon auto via toolkits.authorize)
# COMPOSIO_TIKTOK_AUTH_CONFIG_ID=ac_...

# Stockage S3 (recommandé en prod) : activé dès que S3_BUCKET est renseigné, sinon fichiers locaux.
S3_BUCKET=
# Encodage vidéo — garde-fous CPU/RAM (machine partagée / ressources limitées)
# Nombre max de cœurs par process ffmpeg (libx264 prend tous les cœurs sinon).
FFMPEG_THREADS=2
# Preset libx264 du montage : "fast" = plus léger CPU + rendu plus rapide
# (fichier ~10-20% plus gros), "medium" = compression max. Défaut: medium.
# FFMPEG_PRESET=fast
# Nb max de tâches simultanées dans un fan-out de pipeline (narrateur/média) :
# borne les gather par segment (TTS, ffmpeg audio, téléchargements). Défaut 3.
PIPELINE_FANOUT_CONCURRENCY=3

# Pipeline queue / disque worker
PIPELINE_MIN_FREE_DISK_BYTES=10737418240
PIPELINE_QUEUE_DEQUEUE_MAX_ATTEMPTS=50
PIPELINE_QUEUE_BLOCKED_BACKOFF_SECONDS=30

S3_REGION=eu-west-3
S3_KEY_PREFIX=cutevideo
S3_PRESIGN_TTL_SECONDS=3600
S3_ENDPOINT_URL=
S3_DELETE_LOCAL_AFTER_UPLOAD=true
STORAGE_RETENTION_DAYS=30
S3_MAX_STORAGE_BYTES=10737418240
S3_STORAGE_BUFFER_BYTES=524288000
# Identifiants lus directement par boto3 (variables d'environnement AWS standard)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# TTS Azure Neural (production) — edge-tts en fallback si absent
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_ENGINE=azure

# Gemini TTS (optionnel) — utilise GOOGLE_GEMINI_API_KEY déjà définie ci-dessous.
# Configurer apply_to dans data/agent_config.json ou par chaîne : off | shorts | long | both

# Images IA fallback (Flux via fal.ai + Google Imagen 3 via Vertex AI)
FAL_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Gemini API key (AI Studio) — recherche, scoring média, et TTS Gemini Flash (optionnel)
GOOGLE_GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=europe-west1

# Scheduler intégré à l'API
SCHEDULER_ENABLED=true

# Config pipeline (itérations / score critique : data/agent_config.json ou réglages chaîne)
CONFIG_PATH=./data/agent_config.json

# Docker local (docker compose up -d app-dev) + docker-deploy.sh en prod
PORT=3000
# En prod avec Tailscale : mettre l'IP Tailscale du VPS (tailscale ip -4)
# Laisser vide en dev local (expose sur toutes les interfaces)
APP_HOST=
INTERNAL_API_URL=http://127.0.0.1:8000
# En Docker dev (app-dev), SCHEDULER_ENABLED=false est forcé dans docker-compose.yml.
# Les pipelines sont exécutés par le service worker-dev (queue Redis).
# SCHEDULER_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# En Docker local, DATABASE_URL et REDIS_URL sont surchargés dans docker-compose.yml.
# Après un git pull contenant de nouvelles migrations Alembic :
#   docker compose restart app-dev worker-dev
# ou : docker compose run --rm --no-deps --entrypoint alembic app-dev upgrade head
# Pour OAuth depuis le dashboard Docker, utiliser l'URL externe du proxy Next :
# API_BASE_URL=http://localhost:3000
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/channels/youtube/oauth/callback

# Production VPS — déployer avec docker-deploy.sh (le script connecte aussi local-network)
DATABASE_URL=postgresql+asyncpg://cutevideo:MOT_DE_PASSE@shared-postgres:5432/cutevideo
REDIS_URL=redis://redis:6379
